MOTO_VERSION=5.2.5
AWS_CLI_VERSION=2.40.1
# Host port for the mock (the usual LocalStack edge port, so existing tooling just works)
MOTO_PORT=4566
AWS_DEFAULT_REGION=us-east-1

# --- Real LocalStack (profile "localstack") ---
LOCALSTACK_VERSION=2026.10.7
# Free account token from https://app.localstack.cloud (required since 2026-03). Never commit it.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PORT=4567
# Comma-separated list to start only some services, e.g. s3,sqs,dynamodb (empty = all)
LOCALSTACK_SERVICES=
# 1 = keep state in the localstack-data volume across restarts
LOCALSTACK_PERSISTENCE=0
