# All variables are optional; the defaults below are used when unset.
REDPANDA_VERSION=v26.2.6
REDPANDA_CONSOLE_VERSION=v3.14.0
# Memory reserved for the single Seastar shard (dev-container mode)
REDPANDA_MEMORY=1G
# Hostname/IP that host-side Kafka clients use to reach the broker. Change it when clients run on another machine.
REDPANDA_EXTERNAL_HOST=localhost
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8085
