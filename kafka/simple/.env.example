KAFKA_VERSION=4.4.0
KAFKA_PORT=9092
# Hostname clients outside docker use to reach the broker (the advertised EXTERNAL listener)
KAFKA_EXTERNAL_HOST=localhost
KAFKA_NUM_PARTITIONS=3
# Any 22-char base64 UUID: docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
