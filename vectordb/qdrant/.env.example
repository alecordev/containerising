# All variables are optional; the defaults below are used when unset.
QDRANT_VERSION=v1.20.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Leave empty for no auth. If set, send the header `api-key: <value>` (smoke.py sends it if QDRANT_API_KEY is also set in your shell environment).
QDRANT_API_KEY=
