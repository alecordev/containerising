# All variables are optional; the defaults below are used when unset.
WEAVIATE_VERSION=1.40.5
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
# Comma-separated Weaviate modules, e.g. text2vec-openai,generative-openai. Empty = bring your own vectors.
WEAVIATE_MODULES=
# Needed only by the OpenAI modules
OPENAI_APIKEY=
