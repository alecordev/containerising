# =============================================================================
# Repo-wide .gitignore for the containerising templates
# Sections: Docker runtime state | Secrets | Python | Node | Editors | OS
# =============================================================================

# -----------------------------------------------------------------------------
# Docker / docker-compose runtime state (bind-mounted volumes written by containers)
# -----------------------------------------------------------------------------
# Convention used by the templates: ./.docker/<service>/... holds persistent data
.docker/
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Generic data / log dirs that compose files bind-mount (postgres, mongo, mariadb,
# elasticsearch, pgadmin, airflow, ...)
data/
logs/
pgadmin/
__logger/

# Per-service bind-mount directories that are NOT created under .docker/
# (database/broker data now lives in named volumes; only these remain)
airflow/logs/
# airflow/dags and airflow/plugins are user code: keep them tracked.

# Database files / dumps produced locally
*.sqlite3
*.sqlite3-journal
*.db
*.rdb
*.aof
*.dump
*.pid
*.sock

# Build output of docker buildx / bake
docker-bake.override.hcl
*.tar.gz.tmp

# Large datasets and partial downloads (wikipedia/ keeps ZIM snapshots under data/)
*.zim
*.zim.part
*.zim.corrupt
*.part
wikipedia-manifest.json

# Smoke-test logs, if SMOKE_LOG_DIR points inside the repo
smoke-logs/
.smoke-logs/

# Names mangled by a Windows bind mount (e.g. "scripts;C" from `-v C:\path:/x`): never commit these
*;*
nul
NUL
*.tmp

# -----------------------------------------------------------------------------
# Secrets & local environment configuration
# -----------------------------------------------------------------------------
# Real env files are local. Commit a `.env.example` with dummy values instead.
# NOTE: .env files already tracked in git (all/, lamp/, postgresql/, rabbitmq/)
# stay tracked until you run `git rm --cached <file>`.
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.env
!*.env.example

# Credentials / keys / certs
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
secrets/
.secrets/
credentials*.json
service-account*.json
.aws/
.netrc

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Logs
*.log

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx / mkdocs
docs/_build/
/site

# PyBuilder
.pybuilder/
target/

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# pyenv / pipenv / poetry / uv
# .python-version
#Pipfile.lock
# poetry.lock / uv.lock: commit these for applications.
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Virtual environments
.venv
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# Selenium / browser automation artifacts
geckodriver.log
chromedriver
geckodriver
screenshots/
*.har

# Spark
spark-warehouse/
metastore_db/
derby.log

# -----------------------------------------------------------------------------
# Node (selenium/web helpers, dashboards)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.#*
\#*#

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# AI agent local state
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
AGENTS.local.md
