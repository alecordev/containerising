TRAEFIK_VERSION=v3.7.18
WHOAMI_VERSION=v1.12.0
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
# Dashboard (unauthenticated, dev only): http://localhost:8088/dashboard/
TRAEFIK_DASHBOARD_PORT=8088
TRAEFIK_LOG_LEVEL=INFO
# Docker network Traefik talks to upstreams on; other stacks must join it
TRAEFIK_NETWORK=proxy
