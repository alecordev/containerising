# Copy to .env. On Linux set AIRFLOW_UID to `id -u` so bind-mounted files aren't owned by root.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_LOAD_EXAMPLES=false
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change-me-dev-only
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Quick-and-dirty extra pip packages (installed at every start)
_PIP_ADDITIONAL_REQUIREMENTS=
