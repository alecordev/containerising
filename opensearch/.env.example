# All variables are optional; the defaults below are used when unset.
OPENSEARCH_VERSION=3.9.0
OPENSEARCH_HEAP=1g
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
# 5602 avoids clashing with Kibana (5601) from the elasticsearch/ and all/ templates
DASHBOARDS_PORT=5602
# Dev-only. Must satisfy OpenSearch's password strength rules even with security disabled.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev-Opensearch-9!
# Set to false to enable the security plugin (HTTPS + basic auth: admin / the password above).
# Then use https://localhost:9200 with `curl -k -u admin:<password>` and configure Dashboards for HTTPS.
OPENSEARCH_DISABLE_SECURITY=true
