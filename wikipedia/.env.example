# Copy to .env to override defaults. Dev-only values.

# What to download. Comma separated. Presets: sample (default, ~320 MB), top-mini (~0.3 GB),
# top-nopic (2.6 GB), top-maxi (6.5 GB), all-mini (13 GB), all-nopic (49 GB), all-maxi (119 GB).
# Or [lang:]set[:flavour] such as fr:all:nopic, or an exact file name to pin a snapshot.
WIKI_DATASETS=sample

# Host port for the Kiwix web UI.
WIKI_PORT=8099

# Where the ZIM files live on the host (any directory; it is mounted at /data).
WIKI_DATA_DIR=./data

# Linux only: run the downloader as yourself so ./data stays owned by you.
# WIKI_UID=1000
# WIKI_GID=1000

# Mirror and image versions.
WIKI_MIRROR=https://download.kiwix.org/zim/wikipedia/
KIWIX_VERSION=3.8.2
PYTHON_VERSION=3.14

# Corporate proxy / TLS-inspecting proxy (or run `python prep/wiki.py download` on the host instead).
# HTTPS_PROXY=http://proxy.example:8080
# WIKI_INSECURE=1
