ADMINER_VERSION=6.3.0-standalone
ADMINER_PORT=8082
# Server pre-filled on the login form (a container name on the dbnet network)
ADMINER_DEFAULT_SERVER=postgres
# Any folder name from https://github.com/vrana/adminer/tree/master/designs
ADMINER_DESIGN=pepa-linha
DEMO_POSTGRES_VERSION=18.6-alpine
# Name of the shared Docker network
DBNET_NAME=dbnet
