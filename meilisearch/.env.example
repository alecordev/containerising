# All variables are optional; the defaults below are used when unset.
MEILI_VERSION=v1.56.2
MEILI_PORT=7700
# development: dashboard at / is open; production: master key required and dashboard disabled
MEILI_ENV=development
# At least 16 bytes. Dev-only default. Generate one: python -c "import secrets; print(secrets.token_hex(16))"
MEILI_MASTER_KEY=dev-master-key-change-me-16b
