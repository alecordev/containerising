GITEA_VERSION=28.3
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=gitea
GITEA_DISABLE_REGISTRATION=true

# Actions runner (profile `runner`): token from `gitea actions generate-runner-token`
ACT_RUNNER_VERSION=0.6.1
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_RUNNER_NAME=local-runner
GITEA_RUNNER_LABELS=ubuntu-latest:docker://gitea/runner-images:ubuntu-latest
