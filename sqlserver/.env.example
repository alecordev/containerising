# Copy to .env to override. Every variable has a default in docker-compose.yml.
MSSQL_VERSION=2025-CU9-GDR1-ubuntu-24.04
# Setting ACCEPT_EULA=Y accepts the SQL Server licence terms.
ACCEPT_EULA=Y
# Developer (free, non-production), Express, Standard, Enterprise, ...
MSSQL_PID=Developer
# Needs 8+ chars with upper, lower, digits and symbols. Quote it if it contains special shell characters.
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
MSSQL_MEMORY_LIMIT_MB=2048
MSSQL_AGENT_ENABLED=false
MSSQL_PORT=1433
TZ=UTC
