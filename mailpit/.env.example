# All variables are optional; the defaults below are used when unset.
MAILPIT_VERSION=v1.33.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Maximum messages kept (oldest are pruned)
MP_MAX_MESSAGES=5000
# Accept any SMTP login (no real auth) and allow it without TLS: dev only
MP_SMTP_AUTH_ACCEPT_ANY=1
MP_SMTP_AUTH_ALLOW_INSECURE=1
TZ=UTC
