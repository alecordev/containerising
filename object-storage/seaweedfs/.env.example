SEAWEEDFS_VERSION=4.53
AWS_CLI_VERSION=2.40.1
# S3 credentials (dev only). Used by the server AND the `aws` helper service.
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
# Max size of one volume file; smaller values let many buckets fit on a small disk
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=512
