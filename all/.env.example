# Copy to .env to override defaults. Every variable is optional for docker-compose.yml.
# Variables are also read by the Python examples in examples/ (python-dotenv).

# --- Redis
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# --- RabbitMQ (compose)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- RabbitMQ (examples)
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=test
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE_NAME=test
RABBITMQ_ROUTING_KEY=test

# --- PostgreSQL / pgAdmin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=pgadmin@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin

# --- MongoDB / Mongo Express
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_DB=auth
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# --- Elasticsearch / Kibana
ELASTIC_VERSION=9.5.6
ES_HEAP=1g
ES_PORT=9200
KIBANA_PORT=5601
